{
  "name": "@cogita/plugin-i18n",
  "version": "0.1.0",
  "description": "为 Cogita 主题提供英文优先的界面文案国际化能力。",
  "keywords": ["cogita", "plugin", "i18n", "internationalization", "localization", "rspress"],
  "author": "wu9o <https://github.com/wu9o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu9o/cogita.git",
    "directory": "plugins/i18n"
  },
  "bugs": {
    "url": "https://github.com/wu9o/cogita/issues"
  },
  "homepage": "https://github.com/wu9o/cogita/tree/main/plugins/i18n#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build -w",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@cogita/shared": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "0.11.2",
    "@rspress/core": "^1.45.1",
    "rsbuild-plugin-publint": "^0.3.3",
    "typescript": "^5.0.4"
  }
}
