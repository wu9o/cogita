{
  "name": "@cogita/plugin-blog-list",
  "version": "0.3.1",
  "description": "文章列表、分页与归档插件，为 Cogita 提供可复用的静态列表页面。",
  "keywords": ["cogita", "plugin", "blog-list", "archive", "pagination", "rspress"],
  "author": "wu9o <https://github.com/wu9o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu9o/cogita.git",
    "directory": "plugins/blog-list"
  },
  "bugs": {
    "url": "https://github.com/wu9o/cogita/issues"
  },
  "homepage": "https://github.com/wu9o/cogita/tree/main/plugins/blog-list#readme",
  "type": "module",
  "exports": {
    ".": {
