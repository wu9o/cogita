{
  "name": "cogita",
  "version": "0.0.0",
  "description": "A theme-driven static site framework based on Rspress",
  "private": true,
  "keywords": ["rspress", "static-site", "documentation", "markdown", "react", "plugins", "themes"],
  "author": "wu9o",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu9o/cogita.git"
  },
  "scripts": {
    "dev": "pnpm --filter docs-site dev",
    "build": "pnpm run build:docs",
    "build:docs": "pnpm run build:packages && pnpm --filter docs-site build",
    "build:packages": "pnpm --filter \"@cogita/*\" build",
    "build:plugin": "pnpm --filter @cogita/plugin-posts-frontmatter build",
    "check:package-boundary": "pnpm run build:packages && node scripts/check-package-boundary.mjs",
    "check:compatibility": "node scripts/check-compatibility-matrix.mjs",
    "check:consumer": "pnpm run build:packages && node scripts/check-consumer-install.mjs",
    "check:external-blog": "pnpm run build:packages && node scripts/check-external-blog.mjs",
    "check:docs-consumer": "pnpm run build:packages && node scripts/check-docs-consumer.mjs",
    "check:cli-templates": "pnpm run build:packages && node scripts/check-cli-templates.mjs",
    "check:starters": "pnpm run build:packages && node scripts/check-starters.mjs",
    "check:registry-consumer": "node scripts/check-registry-consumer.mjs",
    "check:release": "pnpm run build:packages && pnpm run check && pnpm test && pnpm run check:compatibility && node scripts/check-cli-templates.mjs && node scripts/check-starters.mjs && node scripts/check-package-boundary.mjs && node scripts/check-consumer-install.mjs && node scripts/check-external-blog.mjs && node scripts/check-docs-consumer.mjs",
    "preview:lucid": "node scripts/preview-lucid.mjs",
    "deploy": "pnpm run build:docs",
    "preview": "pnpm --filter docs-site preview",
    "test": "pnpm --filter \"@cogita/*\" test && node --test scripts/tests/*.test.mjs",
    "quality:check": "node scripts/check-quality-reports.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "pnpm --filter \"@cogita/*\" clean",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^5.0.4"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,mdx}": ["biome check --write --no-errors-on-unmatched"]
  }
}
